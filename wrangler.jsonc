{
  "$schema": "https://developers.cloudflare.com/workers/schema/envelope/1.0.0.json",

  "name": "acme-control-plane",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-10",
  "keep_vars": true,

  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_REGION_DO",
        "class_name": "TenantRegionDO"
      },
      {
        "name": "SETTINGS_SCOPE_DO",
        "class_name": "SettingsScopeDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TenantRegionDO", "SettingsScopeDO"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acme-control-plane-db",
      "database_id": "3c5cb7d6-7eff-4936-a661-6a195eb0adbd"
    }
  ],

